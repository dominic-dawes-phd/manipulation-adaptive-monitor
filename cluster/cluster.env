# The only file to edit for a new cluster. Sourced by every cluster script.
# Defaults are placeholders for UMBC HPCF chip; confirm each with the cluster docs.

SLURM_CLUSTER_FLAG="-M chip-gpu"        # empty on single-cluster sites
ACCOUNT="pi_TODO_group"
PARTITION=""                            # leave empty to use the account default
GPU_CONSTRAINT="L40S"                   # one GPU model per experiment (D-09)
TIME_PER_SHARD="12:00:00"
CPUS_PER_SHARD=8
MEM_PER_SHARD="48G"

# Everything large lives off home (home quotas are small).
DATA_DIR="/umbc/rs/TODO_group/users/$USER/amon"
HF_HOME="$DATA_DIR/hf"
VENV_SIM="$DATA_DIR/.venv"
VENV_VLM="$DATA_DIR/.venv-vlm"
RUNS_DIR="$DATA_DIR/runs"

# Base port for per-shard vLLM servers (shard i uses BASE + i).
VLLM_BASE_PORT=8100
VLLM_MAX_MODEL_LEN=4096

MAIL_USER=""                            # optional: email when collect finishes
